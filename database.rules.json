{
  "rules": {
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "superadmin": {
          ".validate": "newData.isBoolean() && newData.val() === (data.val() === true)"
        },
        "locales": {
          "$local": {
            ".validate": "$local.matches(/^[a-z0-9-]{2,60}$/) && newData.isBoolean()"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "solicitudes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['email', 'fecha'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120 && (newData.val() === auth.token.email || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "fecha": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "locales": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$local": {
        "comidas": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($local).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "$id": {
            ".validate": "newData.hasChildren(['nombre', 'valor', 'categoria'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "descripcion": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "categoria": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "valor": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "oferta": {
              ".validate": "newData.isBoolean()"
            },
            "valorOferta": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "imagen": {
              ".validate": "newData.isString() && newData.val().length <= 2000 && (newData.val() === '' || newData.val().beginsWith('https:'))"
            },
            "medallones": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
            },
            "precios": {
              "doble": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
              },
              "triple": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
              },
              "cuadruple": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
              },
              "$otro": {
                ".validate": false
              }
            },
            "presentaciones": {
              "$cantidad": {
                ".validate": "$cantidad.matches(/^x[1-9][0-9]{0,2}$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
              }
            },
            "distincionBase": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "distinciones": {
              "$v": {
                ".validate": "$v.matches(/^[0-5]$/) && newData.hasChildren(['nombre', 'precio'])",
                "nombre": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
                },
                "precio": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
                },
                "$otro": {
                  ".validate": false
                }
              }
            },
            "ingredientes": {
              "$grupo": {
                ".validate": "$grupo.matches(/^(pan|carne|aderezos)$/)",
                "$i": {
                  ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
                }
              }
            },
            "oculto": {
              ".validate": "newData.isBoolean()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "datos": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($local).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "nombre": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "whatsapp": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "direccion": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "alias": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "costoEnvio": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "costoEnvioFuera": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "opciones": {
            "envio": {
              ".validate": "newData.isBoolean()"
            },
            "transferencia": {
              ".validate": "newData.isBoolean()"
            },
            "tarjeta": {
              ".validate": "newData.isBoolean()"
            },
            "$otro": {
              ".validate": false
            }
          },
          "extras": {
            "medallon": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "carne": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "panEspecial": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "$otro": {
              ".validate": false
            }
          },
          "redes": {
            "$red": {
              ".validate": "$red.matches(/^(instagram|facebook|twitter)$/) && newData.isString() && newData.val().length <= 200"
            }
          },
          "$otro": {
            ".validate": false
          }
        },
        "horarios": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($local).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "$dia": {
            "cerrado": {
              ".validate": "newData.isBoolean()"
            },
            "franjas": {
              "$i": {
                ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['desde', 'hasta'])",
                "desde": {
                  ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
                },
                "hasta": {
                  ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
                },
                "$otro": {
                  ".validate": false
                }
              }
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "visitas": {
          ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($local).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "total": {
            ".write": "root.child('locales').child($local).child('datos').exists()",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "dias": {
            "$dia": {
              ".write": "root.child('locales').child($local).child('datos').exists()",
              ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            }
          }
        }
      }
    },
    "directorio": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
        ".validate": "$slug.matches(/^[a-z0-9-]{2,40}$/) && newData.hasChildren(['nombre', 'visible'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "ciudad": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "rubro": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 200 && (newData.val() === '' || newData.val().beginsWith('https://'))"
        },
        "portada": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && (newData.val() === 'logo' || newData.val().beginsWith('https://'))"
        },
        "logo": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().beginsWith('https://')"
        },
        "visible": {
          ".validate": "newData.isBoolean()"
        },
        "fotoForma": {
          ".validate": "newData.isString() && newData.val().matches(/^(cuadrada|redonda|horizontal|vertical)$/)"
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
